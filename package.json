{
  "name": "nextchat",
  "private": false,
  "license": "mit",
  "scripts": {
    "dev": "next dev",
    "build": "cross-env BUILD_MODE=standalone next build",
    "start": "next start",
    "lint": "eslint .",
    "export": "cross-env BUILD_MODE=export BUILD_APP=1 next build",
    "export:dev": "cross-env BUILD_MODE=export BUILD_APP=1 next dev",
    "verify:export": "node ./scripts/verify-export.mjs",
    "app:dev": "yarn tauri dev",
    "app:build": "node ./scripts/build-app.cjs",
    "app:clear": "yarn tauri dev",
    "prompts": "node ./scripts/fetch-prompts.mjs",
    "prepare": "husky install",
    "proxy-dev": "sh ./scripts/init-proxy.sh && proxychains -f ./scripts/proxychains.conf yarn dev",
    "test": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:ci": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --ci",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.87",
    "@ai-sdk/google": "4.0.104",
    "@ai-sdk/openai": "4.0.101",
    "@ai-sdk/openai-compatible": "3.0.77",
    "@fortaine/fetch-event-source": "^3.0.6",
    "@hello-pangea/dnd": "18.0.1",
    "@next/third-parties": "16.4.3",
    "@streamdown/cjk": "1.0.4",
    "@streamdown/code": "2.0.0",
    "@streamdown/math": "1.0.3",
    "@svgr/webpack": "^6.5.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "ai": "7.0.150",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.9.2",
    "fuse.js": "^7.0.0",
    "heic2any": "^0.0.4",
    "html-to-image": "^1.11.11",
    "idb-keyval": "^6.2.1",
    "katex": "0.16.27",
    "lodash-es": "^4.17.21",
    "mermaid": "^12.2.0",
    "nanoid": "^5.0.3",
    "next": "16.4.3",
    "node-fetch": "^3.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^6.15.0",
    "remark-breaks": "4.0.0",
    "spark-md5": "^3.0.2",
    "streamdown": "2.7.1",
    "use-debounce": "^9.0.4",
    "zod": "3.25.76",
    "zustand": "^4.3.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.14",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.11.30",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/spark-md5": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^13.2.2",
    "prettier": "^3.0.2",
    "tailwindcss": "4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.0",
    "typescript": "5.9.3",
    "watch": "^1.0.2"
  },
  "resolutions": {
    "lint-staged/yaml": "^2.2.2"
  },
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=24"
  }
}
